# ─── Database (Postgres — Supabase or any Postgres host) ────
DATABASE_URL=

# ─── Supabase Auth (required — used by all admin/super-admin login) ──
# Find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key. Also doubles as the fallback signing secret for
# client-portal sessions if CLIENT_SESSION_SECRET is not set.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: explicit signing secret for client-portal session cookies.
# If unset, SUPABASE_SERVICE_ROLE_KEY is used instead.
CLIENT_SESSION_SECRET=

# ─── OpenAI (for Sloane assistant + lead qualification) ─────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ─── Optional integrations ──────────────────────────────────
CAL_BOOKING_URL=
